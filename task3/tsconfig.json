{
  "include": ["index.ts"],
  "compilerOptions": {
      "target": "es2022",
      "lib": ["es2022", "DOM"],
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "outDir": "./dist",
      "sourceMap": true,
      "esModuleInterop": true,
      "allowImportingTsExtensions": true,
      "noEmit": true
  }
}
